{
  "name": "bookkeeping-backend",
  "version": "0.1.0",
  "description": "Bookkeeping application backend API",
  "main": "dist/server.ts",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --loader tsx ./src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node --loader tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "prisma:generate": "prisma generate"
  },
  "keywords": ["bookkeeping", "accounting", "invoicing", "canadian"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "5.6.0",
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "express-rate-limit": "7.1.5",
    "jsonwebtoken": "9.0.2",
    "uuid": "9.0.1",
    "validator": "13.11.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.10.6",
    "@types/validator": "13.11.8",
    "@typescript-eslint/eslint-plugin": "6.17.0",
    "@typescript-eslint/parser": "6.17.0",
    "eslint": "8.56.0",
    "prettier": "3.1.1",
    "prisma": "5.6.0",
    "tsx": "4.7.0",
    "typescript": "5.3.3"
  }
}
