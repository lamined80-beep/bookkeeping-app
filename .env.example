# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bookkeeping"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRY="7d"

# Frontend
VITE_API_URL="http://localhost:5000"
VITE_APP_NAME="Bookkeeping"

# Backend
NODE_ENV="development"
PORT=5000
API_URL="http://localhost:5000"

# Email (future)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SENDER_EMAIL="noreply@bookkeeping.local"

# File Storage (S3-compatible or local)
STORAGE_TYPE="local"  # or "s3"
STORAGE_PATH="./uploads"
# S3_BUCKET=""
# S3_REGION="ca-central-1"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Error Monitoring (optional)
SENTRY_DSN=""

# OCR (optional - Phase 2)
# TEXTRACT_REGION="ca-central-1"
# or use free Tesseract.js (no config needed)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="debug"  # debug, info, warn, error

# CORS
CORS_ORIGIN="http://localhost:5173"
